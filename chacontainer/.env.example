# Copy to .env (same directory as docker-compose.yml) and adjust as needed.
# docker compose reads .env automatically - nothing here is required to get
# started, these are just the two knobs worth changing for local use.

# Signs every JWT issued by /api/v1/auth/login. Any long random string works;
# only matters if you expose this stack beyond localhost.
JWT_SECRET=local-dev-secret-change-me

# Creates a demo tenant + admin user + sample data the first time the
# database is empty. Set to false once you have your own data.
SEED_DEMO_DATA=true
